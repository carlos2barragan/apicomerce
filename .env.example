# Copia este archivo a ".env" y ajusta los valores.
# NUNCA subas el .env real a git.

# Base de datos. Para empezar basta con SQLite.
DATABASE_URL=sqlite:///./ecommerce.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecommerce

# Secreto con el que se firman los tokens JWT. ¡Cámbialo!
JWT_SECRET=cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Caché. Si se deja vacío, usa una caché en memoria (modo dev).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_SECONDS=60

# Límite de peticiones por IP por minuto.
RATE_LIMIT_PER_MINUTE=120

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
